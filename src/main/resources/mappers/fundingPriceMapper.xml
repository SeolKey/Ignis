<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.Ignis.home.funding.mapper.FundingPriceMapper">

    <insert id="insertFundingPrice"
            parameterType="com.Ignis.home.funding.domain.FundingPrice"
            useGeneratedKeys="true"
            keyProperty="fundingPriceId">
        INSERT INTO funding_price (
            funding_id,
            user_id,
            give_price,
            created_at,
            updated_at
        ) VALUES (
                     #{fundingId},
                     #{userId},
                     #{givePrice},
                     NOW(),
                     NOW()
                 )
    </insert>

</mapper>