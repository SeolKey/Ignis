<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
    PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.Ignis.comment.mapper.CommentMapper">

    <!-- 댓글 + 유저이름까지 가져오는 전용 resultMap -->
    <resultMap id="CommentWithUserNameResultMap" type="com.Ignis.comment.domain.Comment">
        <id property="commentId" column="comment_id"/>
        <result property="contentType" column="content_type"/>
        <result property="contentId" column="content_id"/>
        <result property="userId" column="user_id"/>
        <result property="content" column="content"/>
        <result property="parentId" column="parent_id"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
        <result property="userName" column="userName"/>
    </resultMap>

    <!-- 기본 댓글 매핑 -->
    <resultMap id="CommentResultMap" type="com.Ignis.comment.domain.Comment">
        <id property="commentId" column="comment_id"/>
        <result property="contentType" column="content_type"/>
        <result property="contentId" column="content_id"/>
        <result property="userId" column="user_id"/>
        <result property="content" column="content"/>
        <result property="parentId" column="parent_id"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <!-- 댓글 등록 -->
    <insert id="insertComment" parameterType="com.Ignis.comment.domain.Comment" useGeneratedKeys="true" keyProperty="commentId">
        INSERT INTO comment (
            content_type,
            content_id,
            user_id,
            content,
            parent_id,
            created_at,
            updated_at
        )
        VALUES (
            #{contentType},
            #{contentId},
            #{userId},
            #{content},
            #{parentId},
            NOW(),
            NULL
        )
    </insert>

    <!-- 댓글 리스트 조회 (userName 포함) -->
    <select id="selectCommentList" resultMap="CommentWithUserNameResultMap">
        SELECT 
            c.comment_id,
            c.content_type,
            c.content_id,
            c.user_id,
            c.content,
            c.parent_id,
            c.created_at,
            c.updated_at,
            u.name AS userName
        FROM comment c
        JOIN user u ON c.user_id = u.user_id
        WHERE c.content_type = #{contentType}
          AND c.content_id = #{contentId}
          AND c.parent_id IS NULL
        ORDER BY c.created_at ASC
    </select>

    <!-- 대댓글 목록 조회 -->
    <select id="selectReplyList" resultMap="CommentResultMap">
        SELECT *
        FROM comment
        WHERE parent_id = #{parentId}
        ORDER BY created_at ASC
    </select>

    <!-- 단일 댓글 조회 -->
    <select id="selectCommentById" resultMap="CommentResultMap">
        SELECT *
        FROM comment
        WHERE comment_id = #{commentId}
    </select>

    <!-- 댓글 삭제 -->
    <delete id="deleteComment">
        DELETE FROM comment
        WHERE comment_id = #{commentId}
    </delete>

</mapper>
